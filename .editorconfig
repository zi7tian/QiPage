root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 140

[*.{xml,json,toml}]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2
# Markdown uses trailing double-spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
